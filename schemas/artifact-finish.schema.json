{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Seal a binary upload",
  "type": "object",
  "required": [
    "worker_id",
    "attempt_id",
    "fencing_token",
    "length"
  ],
  "properties": {
    "worker_id": {
      "type": "string",
      "minLength": 1
    },
    "attempt_id": {
      "type": "string",
      "format": "uuid"
    },
    "fencing_token": {
      "type": "integer",
      "minimum": 1
    },
    "length": {
      "type": "integer",
      "minimum": 0
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "additionalProperties": false
}
