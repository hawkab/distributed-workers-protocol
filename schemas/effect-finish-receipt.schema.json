{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Durable external response acknowledgement",
  "type": "object",
  "required": [
    "effect_id",
    "execution_id",
    "recorded"
  ],
  "properties": {
    "effect_id": {
      "type": "string",
      "minLength": 1
    },
    "execution_id": {
      "type": "string",
      "format": "uuid"
    },
    "recorded": {
      "const": true
    },
    "candidate_saved": {
      "type": "boolean"
    }
  },
  "additionalProperties": false
}
