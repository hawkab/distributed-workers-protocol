{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Worker connection profile (decoded X-Worker-Profile)",
  "type": "object",
  "required": [
    "schema",
    "capabilities",
    "resources"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": 1
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cpu_logical_cores": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "ram_total_bytes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "ram_available_bytes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "disk_total_bytes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "disk_available_bytes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "cpu_available_cores": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "gpu_status": {
          "enum": [
            "detected",
            "none",
            "unknown"
          ]
        },
        "gpus": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "index"
            ],
            "additionalProperties": false,
            "properties": {
              "index": {
                "type": "integer",
                "minimum": 0
              },
              "compute_units": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "memory_total_bytes": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "memory_available_bytes": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "unified_memory": {
                "type": [
                  "boolean",
                  "null"
                ]
              }
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "gpu_status": {
                "const": "none"
              }
            },
            "required": [
              "gpu_status"
            ]
          },
          "then": {
            "properties": {
              "gpus": {
                "maxItems": 0
              }
            }
          }
        }
      ]
    }
  }
}
