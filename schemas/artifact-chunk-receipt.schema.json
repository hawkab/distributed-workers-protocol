{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Durable binary chunk acknowledgement",
  "type": "object",
  "required": [
    "upload_id",
    "offset",
    "next_offset",
    "length",
    "sha256"
  ],
  "properties": {
    "upload_id": {
      "type": "string",
      "minLength": 1
    },
    "offset": {
      "type": "integer",
      "minimum": 0
    },
    "next_offset": {
      "type": "integer",
      "minimum": 0
    },
    "length": {
      "type": "integer",
      "minimum": 0
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "additionalProperties": false
}
