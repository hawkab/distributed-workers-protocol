{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Record an external HTTP response",
  "type": "object",
  "required": [
    "worker_id",
    "attempt_id",
    "fencing_token",
    "execution_id",
    "request_sha256",
    "response",
    "artifact_ids"
  ],
  "properties": {
    "worker_id": {
      "type": "string",
      "minLength": 1
    },
    "attempt_id": {
      "type": "string",
      "format": "uuid"
    },
    "fencing_token": {
      "type": "integer",
      "minimum": 1
    },
    "execution_id": {
      "type": "string",
      "format": "uuid"
    },
    "request_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "response": {
      "$ref": "http-response.schema.json"
    },
    "artifact_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    }
  },
  "additionalProperties": false
}
