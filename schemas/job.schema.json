{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Enqueue portable job",
  "type": "object",
  "required": [
    "operation",
    "input"
  ],
  "properties": {
    "operation": {
      "type": "string",
      "minLength": 1
    },
    "input": {
      "type": "object"
    },
    "script": {
      "type": "string"
    },
    "idempotency_key": {
      "type": "string"
    },
    "required_capabilities": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "priority": {
      "type": "integer"
    }
  },
  "additionalProperties": false
}
