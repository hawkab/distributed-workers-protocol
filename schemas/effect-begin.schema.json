{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Reserve one external HTTP execution",
  "type": "object",
  "required": [
    "worker_id",
    "attempt_id",
    "fencing_token",
    "execution_id",
    "request"
  ],
  "properties": {
    "worker_id": {
      "type": "string",
      "minLength": 1
    },
    "attempt_id": {
      "type": "string",
      "format": "uuid"
    },
    "fencing_token": {
      "type": "integer",
      "minimum": 1
    },
    "execution_id": {
      "type": "string",
      "format": "uuid"
    },
    "request": {
      "$ref": "http-request.schema.json"
    }
  },
  "additionalProperties": false
}
