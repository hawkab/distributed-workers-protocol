{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Soft-close an upload without discarding durable bytes",
  "type": "object",
  "required": [
    "worker_id",
    "attempt_id",
    "fencing_token"
  ],
  "properties": {
    "worker_id": {
      "type": "string",
      "minLength": 1
    },
    "attempt_id": {
      "type": "string",
      "format": "uuid"
    },
    "fencing_token": {
      "type": "integer",
      "minimum": 1
    }
  },
  "additionalProperties": false
}
