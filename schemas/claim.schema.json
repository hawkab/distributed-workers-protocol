{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Slot-bound job claim",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "worker_id"
  ],
  "properties": {
    "worker_id": {
      "type": "string",
      "minLength": 1
    },
    "slot_id": {
      "type": "integer",
      "minimum": 0,
      "default": 0
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
