{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Native command stdout result",
  "type": "object",
  "required": [
    "artifact",
    "exit_code",
    "stderr"
  ],
  "properties": {
    "artifact": {
      "$ref": "artifact-ref.schema.json"
    },
    "exit_code": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "signal": {
      "type": "string"
    },
    "error_code": {
      "type": "string"
    },
    "stderr": {
      "type": "object",
      "required": [
        "tail_base64",
        "bytes",
        "retained_bytes",
        "truncated"
      ],
      "properties": {
        "tail_base64": {
          "type": "string",
          "contentEncoding": "base64"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        },
        "retained_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "truncated": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
