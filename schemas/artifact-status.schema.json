{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Bounded durable upload status",
  "type": "object",
  "required": [
    "offset",
    "status",
    "segments_count",
    "cancel_requested"
  ],
  "properties": {
    "upload_id": {
      "type": "string",
      "minLength": 1
    },
    "offset": {
      "type": "integer",
      "minimum": 0
    },
    "status": {
      "type": "string",
      "minLength": 1
    },
    "last_segment": {
      "anyOf": [
        {
          "type": "object",
          "required": [
            "offset",
            "length",
            "sha256"
          ],
          "properties": {
            "offset": {
              "type": "integer",
              "minimum": 0
            },
            "length": {
              "type": "integer",
              "minimum": 0
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "segments_count": {
      "type": "integer",
      "minimum": 0
    },
    "lease_until": {
      "type": "string",
      "format": "date-time"
    },
    "cancel_requested": {
      "type": "boolean"
    },
    "artifact": {
      "$ref": "artifact-ref.schema.json"
    }
  },
  "additionalProperties": false
}
