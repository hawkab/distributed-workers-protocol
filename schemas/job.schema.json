{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Enqueue portable job",
  "type": "object",
  "required": [
    "operation",
    "input"
  ],
  "properties": {
    "operation": {
      "type": "string",
      "minLength": 1
    },
    "input": {
      "type": "object"
    },
    "script": {
      "type": "string",
      "description": "JavaScript source. Legacy run(input,resume) is preserved. Using run(input,resume,ctx) requires javascript.portable.v1 capability; network host calls additionally require http.request and artifact.stream."
    },
    "idempotency_key": {
      "type": "string"
    },
    "required_capabilities": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true,
      "description": "Actual executor capabilities, including javascript.portable.v1 for the versioned ctx host ABI. javascript alone can route to an older two-argument executor."
    },
    "priority": {
      "type": "integer"
    },
    "network": {
      "$ref": "network-policy.schema.json"
    },
    "resource_requirements": {
      "$ref": "resource-requirements.schema.json"
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "operation": {
            "const": "http.request"
          }
        },
        "required": [
          "operation"
        ]
      },
      "then": {
        "properties": {
          "input": {
            "$ref": "http-request.schema.json"
          }
        }
      }
    }
  ]
}
